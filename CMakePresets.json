{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}"
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "dev",
      "configuration": "Debug",
      "targets": [
        "sharpcpp-all"
      ]
    },
    {
      "name": "Release",
      "configurePreset": "dev",
      "configuration": "Release",
      "targets": [
        "sharpcpp-all"
      ]
    },
    {
      "name": "tests-debug",
      "configurePreset": "dev",
      "configuration": "Debug",
      "targets": [
        "sharpcpp-tests"
      ]
    },
    {
      "name": "tests-release",
      "configurePreset": "dev",
      "configuration": "Release",
      "targets": [
        "sharpcpp-tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "Debug",
      "configurePreset": "dev",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "Release",
      "configurePreset": "dev",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
