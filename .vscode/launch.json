{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SharpCpp Tool (Debug)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/SharpCpp.Tool/bin/Debug/net8.0/SharpCpp.Tool.dll",
      "args": ["sample-metadata"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "CMake: Build Tool (Debug)"
    },
    {
      "name": "SharpCpp Tool Sample Metadata to File (Debug)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/SharpCpp.Tool/bin/Debug/net8.0/SharpCpp.Tool.dll",
      "args": ["sample-metadata", "${workspaceFolder}/out/generated/sample/SharpCpp.Sample.Bindings.json"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "CMake: Build Tool (Debug)"
    },
    {
      "name": "Rbfx.Application (Debug)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/out/build/dev/bin/Debug/Rbfx.Application.dll",
      "cwd": "${workspaceFolder}/out/build/dev/bin/Debug",
      "console": "integratedTerminal",
      "env": {
        "LD_LIBRARY_PATH": "${workspaceFolder}/out/build/dev/bin/Debug",
        "LD_PRELOAD": "${workspaceFolder}/out/build/dev/bin/Debug/libUrho3D.so",
        "URHO3D_PREFIX_PATH": "${workspaceFolder}/out/rbfx-sdk/bin"
      }
    },
    {
      "name": "Rbfx.Application (C++ Debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/usr/bin/dotnet",
      "args": ["${workspaceFolder}/out/build/dev/bin/Debug/Rbfx.Application.dll"],
      "cwd": "${workspaceFolder}/out/build/dev/bin/Debug",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "${workspaceFolder}/out/build/dev/bin/Debug"
        },
        {
          "name": "LD_PRELOAD",
          "value": "${workspaceFolder}/out/build/dev/bin/Debug/libUrho3D.so"
        },
        {
          "name": "URHO3D_PREFIX_PATH",
          "value": "${workspaceFolder}/out/rbfx-sdk/bin"
        }
      ],
    }
  ]
}
