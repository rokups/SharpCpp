{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SharpCpp E2E Generator (Debug)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/Debug/SharpCpp.Tests/SharpCpp.Tests.E2E.Generator/SharpCpp.Tests.E2E.Generator.dll",
      "args": ["--generated-root", "${workspaceFolder}/build/native/dev/generated/sharpcpp-e2e", "--project-root", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Build: SharpCpp (Debug)"
    }
  ]
}
