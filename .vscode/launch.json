{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SharpCpp Tool (Debug)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/SharpCpp.Tool/bin/Debug/net8.0/SharpCpp.Tool.dll",
      "args": ["sample-metadata"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "CMake: Build Tool (Debug)"
    },
    {
      "name": "SharpCpp Tool Sample Metadata to File (Debug)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/SharpCpp.Tool/bin/Debug/net8.0/SharpCpp.Tool.dll",
      "args": ["sample-metadata", "${workspaceFolder}/out/generated/sample/SharpCpp.Sample.Bindings.json"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "CMake: Build Tool (Debug)"
    },
    {
      "name": "Rbfx.Application (Debug)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/out/build/dev/bin/Debug/Rbfx.Application.dll",
      "cwd": "${workspaceFolder}/out/build/dev/bin/Debug",
      "console": "integratedTerminal",
      "env": {
        "LD_PRELOAD": "${command:cmake.buildDirectory}/bin/${command:cmake.buildType}/libUrho3D.so",
        "URHO3D_PREFIX_PATH": "${workspaceFolder}/out/rbfx-sdk/bin"
      }
    }
  ]
}
