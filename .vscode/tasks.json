{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: SharpCpp (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "SharpCpp.slnx", "--configuration", "Debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Test: SharpCpp (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "SharpCpp.slnx", "--configuration", "Debug", "--no-build", "--no-restore"],
      "group": { "kind": "test", "isDefault": true },
      "dependsOn": "Build: SharpCpp (Debug)",
      "problemMatcher": "$msCompile"
    }
  ]
}
