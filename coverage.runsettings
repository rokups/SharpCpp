<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- The generic runtime is the core gate. Ea/EASTL is an rbfx opt-in. -->
          <Include>[SharpCpp.Support]*,[SharpCpp.Std]*</Include>
          <Exclude>[SharpCpp.Tests.E2E]*,[SharpCpp.Ea]*</Exclude>
          <UseSourceLink>false</UseSourceLink>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
