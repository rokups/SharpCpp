# Distributes the generated *.g.cpp files of GENERATED_DIR over SHARD_COUNT unity sources
# named <OUTPUT_PREFIX><index>.cpp. The shard names are fixed, so the build graph does not
# depend on which binding files the generator produced; shards are rewritten only when
# their contents change.

file(GLOB generated_sources LIST_DIRECTORIES false "${GENERATED_DIR}/*.g.cpp")
list(SORT generated_sources)

math(EXPR last_shard "${SHARD_COUNT} - 1")
foreach(shard RANGE ${last_shard})
  set("shard_content_${shard}" "// Generated by SharpCppWriteUnitySources.cmake.\n")
endforeach()

set(index 0)
foreach(source IN LISTS generated_sources)
  math(EXPR shard "${index} % ${SHARD_COUNT}")
  string(APPEND "shard_content_${shard}" "#include \"${source}\"\n")
  math(EXPR index "${index} + 1")
endforeach()

foreach(shard RANGE ${last_shard})
  set(shard_path "${OUTPUT_PREFIX}${shard}.cpp")
  set(existing_content "")
  if(EXISTS "${shard_path}")
    file(READ "${shard_path}" existing_content)
  endif()
  if(NOT existing_content STREQUAL shard_content_${shard})
    file(WRITE "${shard_path}" "${shard_content_${shard}}")
  endif()
endforeach()
