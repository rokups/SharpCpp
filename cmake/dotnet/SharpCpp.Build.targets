<Project>
  <PropertyGroup>
    <SharpCppBuildTargetsImported>true</SharpCppBuildTargetsImported>
    <SharpCppCMakeBuildCommand>cmake --build --preset $(Configuration)</SharpCppCMakeBuildCommand>
  </PropertyGroup>

  <Target Name="SharpCppValidateE2ECMakeArtifacts"
          BeforeTargets="CoreCompile;VSTest"
          Condition="'$(MSBuildProjectName)' == 'SharpCpp.Tests.E2E'">
    <ItemGroup>
      <SharpCppRequiredGeneratedSources Include="$(SharpCppGeneratedDir)/**/*.g.cs" Condition="'$(SharpCppGeneratedDir)' != '' and Exists('$(SharpCppGeneratedDir)')" />
    </ItemGroup>

    <Error Condition="'$(SharpCppCMakeBuildDir)' == '' or '$(SharpCppGeneratedDir)' == '' or '$(SharpCppGeneratedStamp)' == '' or '$(SharpCppE2ENativeLibraryPath)' == ''"
           Text="CMake-generated SharpCpp E2E artifact paths are not configured for $(Configuration). Run: cmake --preset dev &amp;&amp; $(SharpCppCMakeBuildCommand)" />
    <Error Condition="'@(SharpCppRequiredGeneratedSources)' == ''"
           Text="CMake-generated SharpCpp E2E sources are missing for $(Configuration) at '$(SharpCppGeneratedDir)'. Run: $(SharpCppCMakeBuildCommand)" />
    <Error Condition="!Exists('$(SharpCppGeneratedStamp)')"
           Text="CMake-generated SharpCpp E2E stamp is missing for $(Configuration): '$(SharpCppGeneratedStamp)'. Run: $(SharpCppCMakeBuildCommand)" />
    <Error Condition="!Exists('$(SharpCppE2ENativeLibraryPath)')"
           Text="CMake-built SharpCpp E2E native library is missing for $(Configuration): '$(SharpCppE2ENativeLibraryPath)'. Run: $(SharpCppCMakeBuildCommand)" />
  </Target>

  <Target Name="SharpCppValidateRbfxBindingsCMakeArtifacts"
          BeforeTargets="CoreCompile;VSTest"
          Condition="'$(MSBuildProjectName)' == 'SharpCpp.Rbfx.Bindings'">
    <ItemGroup>
      <SharpCppRequiredGeneratedSources Include="$(SharpCppGeneratedDir)/**/*.g.cs" Condition="'$(SharpCppGeneratedDir)' != '' and Exists('$(SharpCppGeneratedDir)')" />
    </ItemGroup>

    <Error Condition="'$(SharpCppCMakeBuildDir)' == '' or '$(SharpCppGeneratedDir)' == '' or '$(SharpCppRbfxNativeLibraryPath)' == ''"
           Text="CMake-generated rbfx binding artifact paths are not configured for $(Configuration). Run: cmake --preset dev &amp;&amp; $(SharpCppCMakeBuildCommand)" />
    <Error Condition="'@(SharpCppRequiredGeneratedSources)' == ''"
           Text="CMake-generated rbfx binding sources are missing for $(Configuration) at '$(SharpCppGeneratedDir)'. Run: $(SharpCppCMakeBuildCommand)" />
    <Error Condition="!Exists('$(SharpCppRbfxNativeLibraryPath)')"
           Text="CMake-built rbfx native library is missing for $(Configuration): '$(SharpCppRbfxNativeLibraryPath)'. Run: $(SharpCppCMakeBuildCommand)" />
  </Target>

  <Target Name="SharpCppValidateRbfxUserCodeBindingsCMakeArtifacts"
          BeforeTargets="CoreCompile;VSTest"
          Condition="'$(MSBuildProjectName)' == 'Rbfx.UserCode.Bindings'">
    <ItemGroup>
      <SharpCppRequiredUserCodeGeneratedSources Include="$(SharpCppUserCodeGeneratedDir)/**/*.g.cs" Condition="'$(SharpCppUserCodeGeneratedDir)' != '' and Exists('$(SharpCppUserCodeGeneratedDir)')" />
    </ItemGroup>

    <Error Condition="'$(SharpCppCMakeBuildDir)' == '' or '$(SharpCppUserCodeGeneratedDir)' == '' or '$(SharpCppGeneratedStamp)' == '' or '$(SharpCppRbfxUserCodeNativeLibraryPath)' == ''"
           Text="CMake-generated rbfx user-code artifact paths are not configured for $(Configuration). Run: cmake --preset dev &amp;&amp; $(SharpCppCMakeBuildCommand)" />
    <Error Condition="'@(SharpCppRequiredUserCodeGeneratedSources)' == ''"
           Text="CMake-generated rbfx user-code sources are missing for $(Configuration) at '$(SharpCppUserCodeGeneratedDir)'. Run: $(SharpCppCMakeBuildCommand)" />
    <Error Condition="!Exists('$(SharpCppGeneratedStamp)')"
           Text="CMake-generated rbfx user-code stamp is missing for $(Configuration): '$(SharpCppGeneratedStamp)'. Run: $(SharpCppCMakeBuildCommand)" />
    <Error Condition="!Exists('$(SharpCppRbfxUserCodeNativeLibraryPath)')"
           Text="CMake-built rbfx user-code native library is missing for $(Configuration): '$(SharpCppRbfxUserCodeNativeLibraryPath)'. Run: $(SharpCppCMakeBuildCommand)" />
  </Target>

  <Target Name="SharpCppValidateRbfxE2ECMakeArtifacts"
          BeforeTargets="CoreCompile;VSTest"
          Condition="'$(MSBuildProjectName)' == 'SharpCpp.Rbfx.Tests.E2E'">
    <ItemGroup>
      <SharpCppRequiredRbfxGeneratedSources Include="$(SharpCppGeneratedDir)/**/*.g.cs" Condition="'$(SharpCppGeneratedDir)' != '' and Exists('$(SharpCppGeneratedDir)')" />
    </ItemGroup>

    <Error Condition="'$(SharpCppCMakeBuildDir)' == '' or '$(SharpCppGeneratedDir)' == '' or '$(SharpCppRbfxRunSettingsPath)' == '' or '$(SharpCppRbfxNativeLibraryPath)' == '' or '$(SharpCppRbfxUserCodeBindingsDll)' == '' or '$(SharpCppRbfxUserCodeNativeLibraryPath)' == ''"
           Text="CMake-generated rbfx E2E artifact paths are not configured for $(Configuration). Run: cmake --preset dev &amp;&amp; $(SharpCppCMakeBuildCommand)" />
    <Error Condition="'@(SharpCppRequiredRbfxGeneratedSources)' == ''"
           Text="CMake-generated rbfx sources are missing for $(Configuration) at '$(SharpCppGeneratedDir)'. Run: $(SharpCppCMakeBuildCommand)" />
    <Error Condition="!Exists('$(SharpCppGeneratedStamp)')"
           Text="CMake-generated rbfx stamp is missing for $(Configuration): '$(SharpCppGeneratedStamp)'. Run: $(SharpCppCMakeBuildCommand)" />
    <Error Condition="'$(SharpCppUserCodeGeneratedStamp)' != '' and !Exists('$(SharpCppUserCodeGeneratedStamp)')"
           Text="CMake-generated rbfx user-code stamp is missing for $(Configuration): '$(SharpCppUserCodeGeneratedStamp)'. Run: $(SharpCppCMakeBuildCommand)" />
    <Error Condition="!Exists('$(SharpCppRbfxRunSettingsPath)')"
           Text="CMake-generated rbfx E2E runsettings are missing for $(Configuration): '$(SharpCppRbfxRunSettingsPath)'. Run: $(SharpCppCMakeBuildCommand)" />
    <Error Condition="!Exists('$(SharpCppRbfxNativeLibraryPath)')"
           Text="CMake-built rbfx native library is missing for $(Configuration): '$(SharpCppRbfxNativeLibraryPath)'. Run: $(SharpCppCMakeBuildCommand)" />
    <Error Condition="!Exists('$(SharpCppRbfxUserCodeBindingsDll)')"
           Text="CMake-built rbfx user-code bindings DLL is missing for $(Configuration): '$(SharpCppRbfxUserCodeBindingsDll)'. Run: $(SharpCppCMakeBuildCommand)" />
    <Error Condition="!Exists('$(SharpCppRbfxUserCodeNativeLibraryPath)')"
           Text="CMake-built rbfx user-code native library is missing for $(Configuration): '$(SharpCppRbfxUserCodeNativeLibraryPath)'. Run: $(SharpCppCMakeBuildCommand)" />
    <Error Condition="'$(SharpCppRbfxUrho3DRuntimeLibraryPath)' != '' and !Exists('$(SharpCppRbfxUrho3DRuntimeLibraryPath)')"
           Text="CMake-copied rbfx runtime dependency is missing for $(Configuration): '$(SharpCppRbfxUrho3DRuntimeLibraryPath)'. Run: $(SharpCppCMakeBuildCommand)" />
  </Target>
</Project>
