<Project>
  <PropertyGroup>
    <SharpCppBuildTargetsImported>true</SharpCppBuildTargetsImported>
    <SharpCppIsGeneratedConsumer Condition="'$(MSBuildProjectName)' == 'SharpCpp.Tests.E2E' or '$(MSBuildProjectName)' == 'SharpCpp.Rbfx.Bindings' or '$(MSBuildProjectName)' == 'Rbfx.UserCode.Bindings'">true</SharpCppIsGeneratedConsumer>
  </PropertyGroup>

  <ItemGroup Condition="'$(SharpCppIsGeneratedConsumer)' == 'true'">
    <Compile Include="$(SharpCppE2EGeneratedDir)/**/*.g.cs"
             LinkBase="Generated"
             Visible="false"
             SharpCppGeneratedSource="true"
             Condition="'$(MSBuildProjectName)' == 'SharpCpp.Tests.E2E' and Exists('$(SharpCppE2EGeneratedDir)')" />
    <Compile Include="$(SharpCppRbfxGeneratedDir)/**/*.g.cs"
             LinkBase="Generated"
             Visible="false"
             SharpCppGeneratedSource="true"
             Condition="'$(MSBuildProjectName)' == 'SharpCpp.Rbfx.Bindings' and Exists('$(SharpCppRbfxGeneratedDir)')" />
    <Compile Include="$(SharpCppUserCodeGeneratedDir)/**/*.g.cs"
             LinkBase="Generated"
             Visible="false"
             SharpCppGeneratedSource="true"
             Condition="'$(MSBuildProjectName)' == 'Rbfx.UserCode.Bindings' and Exists('$(SharpCppUserCodeGeneratedDir)')" />
  </ItemGroup>

  <ItemGroup Condition="'$(SharpCppIsGeneratedConsumer)' == 'true'">
    <ProjectReference Include="$(SharpCppRoot)/native/SharpCpp.Native/SharpCpp.Native.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true"
                      SharpCppProperties="SharpCppBuildE2E=$(SharpCppBuildE2E);SharpCppBuildRbfx=$(SharpCppBuildRbfx)" />
  </ItemGroup>

  <Target Name="SharpCppSetProjectReferenceProperties"
          AfterTargets="_SplitProjectReferencesByFileExistence"
          BeforeTargets="_GetProjectReferenceTargetFrameworkProperties;ResolveProjectReferences">
    <ItemGroup>
      <_MSBuildProjectReferenceExistent Update="@(_MSBuildProjectReferenceExistent)">
        <SetConfiguration>%(_MSBuildProjectReferenceExistent.SetConfiguration);Configuration=$(Configuration)</SetConfiguration>
        <GlobalPropertiesToRemove>TargetFramework;RuntimeIdentifier;SelfContained;SharpCppBuildE2E;SharpCppBuildRbfx</GlobalPropertiesToRemove>
      </_MSBuildProjectReferenceExistent>
      <_MSBuildProjectReferenceExistent Update="@(_MSBuildProjectReferenceExistent)"
                                        Condition="'%(_MSBuildProjectReferenceExistent.SharpCppProperties)' != ''">
        <SetConfiguration>%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SharpCppProperties)</SetConfiguration>
        <GlobalPropertiesToRemove>TargetFramework;RuntimeIdentifier;SelfContained;Platform</GlobalPropertiesToRemove>
      </_MSBuildProjectReferenceExistent>
    </ItemGroup>
  </Target>

  <Target Name="SharpCppIncludeGeneratedSources"
          BeforeTargets="CoreCompile"
          Condition="'$(SharpCppIsGeneratedConsumer)' == 'true'">
    <ItemGroup>
      <Compile Remove="@(Compile)"
               Condition="'%(Compile.SharpCppGeneratedSource)' == 'true' and !Exists('%(Compile.FullPath)')" />
      <SharpCppRequiredGeneratedSources Include="$(SharpCppE2EGeneratedDir)/**/*.g.cs"
                                        Condition="'$(MSBuildProjectName)' == 'SharpCpp.Tests.E2E' and Exists('$(SharpCppE2EGeneratedDir)')" />
      <SharpCppRequiredGeneratedSources Include="$(SharpCppRbfxGeneratedDir)/**/*.g.cs"
                                        Condition="'$(MSBuildProjectName)' == 'SharpCpp.Rbfx.Bindings' and Exists('$(SharpCppRbfxGeneratedDir)')" />
      <SharpCppRequiredGeneratedSources Include="$(SharpCppUserCodeGeneratedDir)/**/*.g.cs"
                                        Condition="'$(MSBuildProjectName)' == 'Rbfx.UserCode.Bindings' and Exists('$(SharpCppUserCodeGeneratedDir)')" />
      <Compile Include="@(SharpCppRequiredGeneratedSources)"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Visible="false"
               SharpCppGeneratedSource="true" />
    </ItemGroup>

    <Error Condition="'@(SharpCppRequiredGeneratedSources)' == ''"
           Text="SharpCpp generated sources are missing for $(MSBuildProjectName) at its configured generated output directory." />
    <Error Condition="'$(MSBuildProjectName)' == 'SharpCpp.Tests.E2E' and !Exists('$(SharpCppE2EGeneratedStamp)')"
           Text="SharpCpp E2E generation did not produce '$(SharpCppE2EGeneratedStamp)'." />
    <Error Condition="'$(MSBuildProjectName)' == 'SharpCpp.Tests.E2E' and !Exists('$(SharpCppE2ENativeLibraryPath)')"
           Text="SharpCpp E2E native build did not produce '$(SharpCppE2ENativeLibraryPath)'." />
    <Error Condition="'$(MSBuildProjectName)' == 'SharpCpp.Rbfx.Bindings' and !Exists('$(SharpCppRbfxGeneratedStamp)')"
           Text="SharpCpp rbfx generation did not produce '$(SharpCppRbfxGeneratedStamp)'." />
    <Error Condition="'$(MSBuildProjectName)' == 'SharpCpp.Rbfx.Bindings' and !Exists('$(SharpCppRbfxNativeLibraryPath)')"
           Text="SharpCpp rbfx native build did not produce '$(SharpCppRbfxNativeLibraryPath)'." />
    <Error Condition="'$(MSBuildProjectName)' == 'Rbfx.UserCode.Bindings' and !Exists('$(SharpCppUserCodeGeneratedStamp)')"
           Text="SharpCpp rbfx user-code generation did not produce '$(SharpCppUserCodeGeneratedStamp)'." />
    <Error Condition="'$(MSBuildProjectName)' == 'Rbfx.UserCode.Bindings' and !Exists('$(SharpCppRbfxUserCodeNativeLibraryPath)')"
           Text="SharpCpp rbfx user-code native build did not produce '$(SharpCppRbfxUserCodeNativeLibraryPath)'." />
  </Target>

  <Target Name="SharpCppStageNativeTestRuntime"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'SharpCpp.Tests.E2E' or '$(MSBuildProjectName)' == 'SharpCpp.Rbfx.Tests.E2E'">
    <ItemGroup>
      <SharpCppNativeTestRuntime Include="$(SharpCppOutputDir)/*.so;$(SharpCppOutputDir)/*.so.*"
                                 Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
      <SharpCppNativeTestRuntime Include="$(SharpCppOutputDir)/*.dylib"
                                 Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
      <SharpCppNativeTestRuntime Include="$(SharpCppOutputDir)/*.dll"
                                 Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    </ItemGroup>
    <Copy SourceFiles="@(SharpCppNativeTestRuntime)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
